# MyExams365 — environment template.
#
# Copy to .env.local and fill in. .env* is gitignored; never commit real values.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# public by definition. Everything else is server-only and must stay secret.

# ─────────────────────────────────────────────────────────── Firebase (client)
# Firebase console → Project settings → General → Your apps → SDK setup.
# These are not secrets; access is controlled by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional — Analytics only.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ────────────────────────────────────────────────────── Firebase Admin (server)
# Firebase console → Project settings → Service accounts → Generate new private
# key. Grants full database access, bypassing all security rules.
#
# FIREBASE_PRIVATE_KEY must keep its literal \n escapes and be wrapped in double
# quotes. Pasting it with real newlines is the single most common setup failure;
# when it is wrong every server route fails with FirebaseAdminNotConfiguredError.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ───────────────────────────────────────────────────────────────────── Razorpay
# Dashboard → Settings → API Keys. Use rzp_test_* keys in development; an order
# created under one key/mode is invisible under the other.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=

# Dashboard → Settings → Webhooks. Point the webhook at
# https://<your-domain>/api/payments/razorpay-webhook and subscribe to
# `payment.captured` and `order.paid`. Without this, entitlements depend
# entirely on the browser completing the verify call — close the tab at the
# wrong moment and a paid candidate gets nothing until someone runs the
# reconcile sweep in /admin/orders.
RAZORPAY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────── Email (Resend)
# RESEND_FROM_EMAIL must be on a domain verified in Resend (Domains → Add
# Domain). The library falls back to onboarding@resend.dev, which Resend only
# delivers to the account owner — so leaving this unset means every customer
# invoice, verification code and password reset is silently dropped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=MyExams365
SUPPORT_EMAIL=support@yourdomain.com

# ──────────────────────────────────────────────────────────────────────── Auth
# Deployment-wide secret mixed into every signup OTP hash, so a leaked database
# alone is not enough to recover a live code. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates codes already in flight, which is harmless.
OTP_PEPPER=

# ─────────────────────────────────────────────────── Invoice legal details
# Optional. An Indian tax invoice must carry the seller's registered name and
# GSTIN to be claimable by the buyer. Omitted from the invoice when unset,
# rather than faked.
INVOICE_LEGAL_NAME=
INVOICE_GSTIN=
INVOICE_ADDRESS=

rules_version = '2';

/**
 * Study-note files. Nothing here is reachable with a client SDK — at all.
 *
 * The point of holding files rather than linking to Google Drive is that a
 * Drive link set to "anyone with the link" stays open to whoever it is
 * forwarded to. Repeating that here would be worse, so every path denies both
 * reads and writes, for everyone, signed in or not.
 *
 * Both directions are handled server-side with signed URLs instead:
 *
 *   uploads    /api/materials/upload-url  — admin only, 15-minute signature
 *   downloads  /api/materials/download    — checks the entitlement and the
 *                                           plan tier, 5-minute signature
 *
 * An earlier version allowed admin writes here and identified the admin by
 * reading their role out of Firestore. That cross-service lookup refused every
 * upload in practice, and it meant the feature only worked if a rule in another
 * service stayed correct. Deciding it in the API route removes that coupling
 * entirely: there is now no rule that has to be right for uploads to work, and
 * no rule that can accidentally expose a file if it is wrong.
 */
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

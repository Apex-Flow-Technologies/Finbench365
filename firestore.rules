rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins can read/write everything
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Editors author courses and question banks; admins can do everything.
    function isEditor() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
    }

    function testDoc(testId) {
      return get(/databases/$(database)/documents/mock_tests/$(testId)).data;
    }

    // True if the signed-in caller has a live (unexpired) entitlement for courseId.
    // An empty/unknown courseId can never match, so tests that are unlinked or
    // point at a deleted course fail closed rather than falling open.
    function isEnrolledInCourse(courseId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let entitlement = user.get('enrolledCourses', {}).get(courseId, null);
      return courseId != '' && entitlement != null && entitlement.expiresAt > request.time;
    }

    // Single gate for paid exam content. Applies to practice tests as well as
    // certification exams — practice material is part of the paid course, and
    // exempting it left every published practice test readable by any account.
    function canReadTestContent(testId) {
      return isEditor() ||
        (request.auth != null && isEnrolledInCourse(testDoc(testId).get('courseId', '')));
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can create their initial user doc upon signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can read their own data
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can update their own data BUT CANNOT change their role, enrolledCourses,
      // totalSpent, suspended status, or pending-order tracking (all admin/server-only fields)
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'enrolledCourses', 'totalSpent', 'suspended', 'pendingOrder'])
                    || isAdmin();
      
      allow delete: if isAdmin();
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true; // Public can read published courses
      allow write: if isEditor();
    }
    
    // Chapters Collection
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Mock Tests Collection
    match /mock_tests/{testId} {
      // Test metadata (title, duration, question count) stays publicly readable
      // so the catalogue and marketing pages can list what a course contains.
      // The questions and solutions below are the actual paid content.
      allow read: if true;
      allow write: if isEditor();

      match /questions/{questionId} {
        allow read: if canReadTestContent(testId);
        allow write: if isEditor();
      }

      match /solutions/{questionId} {
        // Answer keys. Practice solutions are released to entitled candidates
        // as part of the learning flow; certification answer keys are never
        // served to any browser — grading happens server-side via the Admin SDK,
        // which bypasses these rules entirely.
        allow read: if isEditor() ||
          (canReadTestContent(testId) && testDoc(testId).get('type', '') == 'practice');
        allow write: if isEditor();
      }
    }

    // Test Attempts
    match /test_attempts/{attemptId} {
      // Users can read and update their own attempts
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Users can create an attempt for themselves
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Users can update their own in-progress attempt, but once it's marked
      // completed it's locked — prevents post-submission score tampering.
      allow update: if request.auth != null &&
                    ((resource.data.userId == request.auth.uid && resource.data.status != 'completed') || isAdmin());

      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false; // Only server (Admin SDK) should write orders
    }

    // Pending signups (hashed OTPs) and rate-limit counters are written only by
    // the Admin SDK, which bypasses these rules. No client may read or write
    // them under any circumstances — read access would expose the material
    // needed to complete someone else's signup, and write access would let a
    // caller reset their own attempt counter or rate-limit budget.
    match /pending_signups/{document} {
      allow read, write: if false;
    }

    match /rate_limits/{document} {
      allow read, write: if false;
    }

    // App Configuration (feature flags, display pricing, etc.) — admin only.
    // Client SDK reads are allowed so authenticated users can react to feature
    // flags; actual checkout pricing is never read from here (see constants/pricing.ts).
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}

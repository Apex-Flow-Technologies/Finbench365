rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admins can read/write everything
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // There is no separate 'editor' role. Authoring courses, question banks and
    // answer keys is admin work, and an admin already satisfied every check the
    // editor role gated — so it only ever added an untested authorization path.

    function testDoc(testId) {
      return get(/databases/$(database)/documents/mock_tests/$(testId)).data;
    }

    // True if the signed-in caller has a live (unexpired) entitlement for courseId.
    // An empty/unknown courseId can never match, so tests that are unlinked or
    // point at a deleted course fail closed rather than falling open.
    function isEnrolledInCourse(courseId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let entitlement = user.get('enrolledCourses', {}).get(courseId, null);
      return courseId != '' && entitlement != null && entitlement.expiresAt > request.time;
    }

    // Single gate for paid exam content. Applies to practice tests as well as
    // certification exams — practice material is part of the paid course, and
    // exempting it left every published practice test readable by any account.
    function canReadTestContent(testId) {
      return isAdmin() ||
        (request.auth != null && isEnrolledInCourse(testDoc(testId).get('courseId', '')));
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can create their initial user doc upon signup
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Users can read their own data
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Users can update their own data BUT CANNOT change their role, enrolledCourses,
      // totalSpent, suspended status, or pending-order tracking (all admin/server-only fields).
      //
      // The parentheses are load-bearing. Without them this reads as
      // `(A && B && C) || isAdmin()` only because `&&` binds tighter than `||` —
      // correct today, but one reordered clause away from granting every signed-in
      // user the admin branch. Stated explicitly rather than left to precedence.
      allow update: if isAdmin() ||
                    (request.auth != null
                     && request.auth.uid == userId
                     && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'enrolledCourses', 'totalSpent', 'suspended', 'pendingOrder']));
      
      allow delete: if isAdmin();
    }

    // The plan tier a caller holds for a course. 0 when not enrolled.
    //
    // Written onto the entitlement at purchase (see grantEntitlement). Rules
    // cannot look a plan id up in a table, so the tier is stored as a number and
    // compared directly. Entitlements granted before this field existed default
    // to the lowest tier rather than the highest — a missing value must not hand
    // out premium material.
    function planTierFor(courseId) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return user.get('enrolledCourses', {}).get(courseId, {}).get('planTier', 1);
    }

    // Courses Collection
    match /courses/{courseId} {
      // The catalogue is public so the storefront can list what is on sale.
      // It carries titles, descriptions and counts — never a link to paid
      // material. Those live in the subcollection below.
      allow read: if true;
      allow write: if isAdmin();

      // Study notes. Each carries the minimum plan tier that unlocks it, which
      // is what keeps the Excel workbook and metrics tracker exclusive to the
      // 60-day plan.
      //
      // These documents hold the actual file links, and this rule is the only
      // thing protecting them. Hiding a locked note in the UI while leaving its
      // URL on the publicly readable course document would protect nothing —
      // anyone could read the course and follow the link.
      match /materials/{materialId} {
        allow read: if isAdmin() ||
          (isEnrolledInCourse(courseId)
           && planTierFor(courseId) >= resource.data.get('minPlanTier', 1));
        allow write: if isAdmin();
      }
    }
    
    // Chapters Collection
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mock Tests Collection
    match /mock_tests/{testId} {
      // Test metadata (title, duration, question count) stays publicly readable
      // so the catalogue and marketing pages can list what a course contains.
      // The questions and solutions below are the actual paid content.
      allow read: if true;
      allow write: if isAdmin();

      match /questions/{questionId} {
        allow read: if canReadTestContent(testId);
        allow write: if isAdmin();
      }

      match /solutions/{questionId} {
        // Answer keys. Practice solutions are released to entitled candidates
        // as part of the learning flow; certification answer keys are never
        // served to any browser — grading happens server-side via the Admin SDK,
        // which bypasses these rules entirely.
        allow read: if isAdmin() ||
          (canReadTestContent(testId) && testDoc(testId).get('type', '') == 'practice');
        allow write: if isAdmin();
      }
    }

    // Test Attempts
    match /test_attempts/{attemptId} {
      // Users can read and update their own attempts
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());

      // Users can create an attempt for themselves. A fresh attempt must start
      // in_progress with no score — otherwise a caller could create one that is
      // already 'completed' with a score of their choosing, which is exactly the
      // tampering the update rule below prevents.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'in_progress'
                    && !('score' in request.resource.data);

      // The ONLY fields a browser may change on its own in-progress attempt:
      // saved answers, review flags, and the liveness timestamps.
      //
      // Restricting this to a status check was not enough. While an attempt was
      // in_progress the client could write ANY field — including
      // {score: 60, status: 'completed'} — which bypassed /api/exams/submit
      // entirely and let a candidate award themselves any mark, on
      // certification exams as well as practice. Grading is server-side work:
      // `score`, `totalQuestions`, `status` and `submittedAt` are written by the
      // Admin SDK, which ignores these rules.
      allow update: if isAdmin() ||
                    (request.auth != null
                     && resource.data.userId == request.auth.uid
                     && request.resource.data.userId == resource.data.userId
                     && resource.data.status != 'completed'
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['answers', 'markedForReview', 'lastSavedAt', 'lastHeartbeatAt']));

      allow delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false; // Only server (Admin SDK) should write orders
    }

    // Pending signups (hashed OTPs) and rate-limit counters are written only by
    // the Admin SDK, which bypasses these rules. No client may read or write
    // them under any circumstances — read access would expose the material
    // needed to complete someone else's signup, and write access would let a
    // caller reset their own attempt counter or rate-limit budget.
    match /pending_signups/{document} {
      allow read, write: if false;
    }

    match /rate_limits/{document} {
      allow read, write: if false;
    }

    // App Configuration (feature flags, display pricing, etc.) — admin only.
    // Client SDK reads are allowed so authenticated users can react to feature
    // flags; actual checkout pricing is never read from here (see constants/pricing.ts).
    match /config/{document} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
